NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://badminton_app_dev:replace_me@localhost:5432/badminton_booking_dev
TEST_DATABASE_URL=postgresql://badminton_app_dev:replace_me@localhost:5432/badminton_booking_test
E2E_DATABASE_URL=postgresql://badminton_app_dev:replace_me@localhost:5432/badminton_booking_e2e
PLAYWRIGHT_BROWSER_CHANNEL=
DATABASE_SSL=false

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d

CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Keep disabled until the webhook, receiving account and deployment are verified.
SEPAY_ENABLED=false
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Verify the sender domain in Resend. The URL is the frontend reset page.
RESEND_API_KEY=
MAIL_FROM=ShuttleUp <no-reply@backtobach.io.vn>
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Required for admin class image upload; configure the same values on Railway.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_local_password_of_at_least_8_characters
